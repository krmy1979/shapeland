{
  "rules": {
    "parents": {
      "$p": {
        ".read": "auth != null && auth.uid === $p",
        ".write": "auth != null && auth.uid === $p"
      }
    },
    "kids": {
      "$k": {
        ".read": "auth != null && (auth.uid === $k || auth.uid === data.child('parent').val())",
        "parent": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "nick": {
          ".write": "auth != null && newData.parent().child('parent').val() === auth.uid && (!data.parent().child('parent').exists() || data.parent().child('parent').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14"
        },
        "code": {
          ".write": "auth != null && newData.parent().child('parent').val() === auth.uid && (!data.parent().child('parent').exists() || data.parent().child('parent').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "limit": {
          ".write": "auth != null && data.parent().child('parent').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
        },
        "progress": {
          ".write": "auth != null && auth.uid === $k"
        },
        "save": {
          ".write": "auth != null && auth.uid === $k",
          ".validate": "newData.isString() && newData.val().length < 400000"
        }
      }
    },
    "kidGroups": {
      "$k": {
        ".read": "auth != null && (auth.uid === $k || auth.uid === root.child('kids/' + $k + '/parent').val())",
        "$g": {
          ".write": "auth != null && root.child('groups/' + $g + '/meta/owner').val() === auth.uid"
        }
      }
    },
    "joinCodes": {
      "$c": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.parent().parent().child('groups/' + newData.val() + '/meta/owner').val() === auth.uid"
      }
    },
    "groups": {
      "$g": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid)"
        },
        "requests": {
          ".read": "auth != null && root.child('groups/' + $g + '/meta/owner').val() === auth.uid",
          "$k": {
            ".read": "auth != null && data.child('parent').val() === auth.uid",
            ".write": "auth != null && (root.child('kids/' + $k + '/parent').val() === auth.uid || root.child('groups/' + $g + '/meta/owner').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('parent').val() === root.child('kids/' + $k + '/parent').val() && newData.child('nick').isString())"
          }
        },
        "members": {
          ".read": "auth != null && (root.child('groups/' + $g + '/meta/owner').val() === auth.uid || data.child(auth.uid).exists())",
          ".write": "auth != null && root.child('groups/' + $g + '/meta/owner').val() === auth.uid",
          "$k": {
            ".read": "auth != null && data.child('parent').val() === auth.uid"
          }
        },
        "presence": {
          ".read": "auth != null && (root.child('groups/' + $g + '/members/' + auth.uid).exists() || root.child('groups/' + $g + '/meta/owner').val() === auth.uid)",
          "$pid": {
            ".write": "auth != null && ((root.child('groups/' + $g + '/members/' + auth.uid).exists() && $pid.beginsWith(auth.uid + '_')) || root.child('groups/' + $g + '/meta/owner').val() === auth.uid)"
          }
        },
        "events": {
          ".read": "auth != null && root.child('groups/' + $g + '/members/' + auth.uid).exists()",
          ".indexOn": ["t"],
          "$e": {
            ".write": "auth != null && root.child('groups/' + $g + '/members/' + auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && (data.child('uid').val() === auth.uid || data.child('t').val() < now - 600000)))",
            ".validate": "newData.hasChildren(['topic', 'd', 'from', 'uid', 't']) && newData.child('topic').isString() && newData.child('topic').val().length <= 16 && newData.child('d').isString() && newData.child('d').val().length <= 6000 && newData.child('t').val() === now"
          }
        }
      }
    }
  }
}
